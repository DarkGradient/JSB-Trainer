using System;
using HarmonyLib;
using Il2Cpp;
using MelonLoader;
using UnityEngine;
using UnityEngine.UI;
using Il2CppInterop.Runtime;
using Il2CppInterop.Runtime.InteropTypes.Arrays;

namespace jsb_new
{
    public static class AudioVisualizer
    {
        public static bool Enabled = false;

        // Настройки внешнего вида визуализатора (зафиксированные оптимальные значения)
        private const int TotalBands = 32;
        public static float CustomBarWidth = 16f;          // Ширина столбцов
        public static float CustomMaxHeight = 340f;        // Максимальная высота столбцов (увеличена до 340px)
        public static float LineThickness = 4f;            // Толщина опорной линии
        public static float BarAlpha = 0.32f;              // Прозрачность полос (увеличена до 32%)
        public static float VisualizerHue = 0.89f;         // Цветовой тон (HSV яркий розовый цвет)
        public static float VerticalOffset = 0f;           // Вертикальное смещение визуализатора на экране
        public static float TotalWidth = 1150f;            // Общая ширина зоны визуализатора на экране

        // Настройки физики и сглаживания
        public static float DecaySpeed = 14f;              // Скорость падения столбцов
        public static float SpatialSmoothingAmount = 0.04f;// Легкое сглаживание, чтобы полосы не сливались в кашу
        public static float AutoGainSpeed = 1.0f;          // Скорость адаптации автоподстройки громкости
        public static float EqScale = 15f;                 // Общая сила буста ВЧ
        public static float EqPower = 2.0f;                // Крутизна изгиба буста ВЧ
        public static float GammaCurve = 1.3f;             // Настраиваемая кривая гамма-чувствительности (0.5 - 2.5)

        // Нативные массивы IL2CPP
        private static Il2CppStructArray<float> _rawSpectrumL = new Il2CppStructArray<float>(512);
        private static Il2CppStructArray<float> _rawSpectrumR = new Il2CppStructArray<float>(512);

        private static float[] _bands = new float[TotalBands];
        private static float[] _spatialSmoothedBands = new float[TotalBands];
        private static float[] _smoothedBands = new float[TotalBands];

        private static GameObject _canvasObject = null!;
        private static GameObject _barsContainer = null!;
        private static GameObject[] _uiBars = null!;
        private static GameObject _centralLine = null!;

        private static AudioSource _musicSource = null!;
        private static float _maxPeak = 0.001f;            // Плавающий пик громкости для автоподстройки (AGC)

        public static void Initialize(HarmonyLib.Harmony harmony)
        {
            HarmonyLib.Harmony.CreateAndPatchAll(typeof(Patch_KeyManager_Update_AudioVisualizer));
        }

        public static void SetEnabledState(bool newValue)
        {
            Enabled = newValue;
            DebugStrings.Log($"AudioVisualizer enabled: {newValue}");
            if (!newValue)
            {
                DestroyVisuals();
            }
        }

        public static bool IsPlayerOnLevel()
        {
            if (GameScene.instance == null || GameScene.instance.logicManager == null)
                return false;

            try
            {
                var normalType = Il2CppType.Of<ActorNormalLevelLogic>();
                if (GameScene.instance.logicManager.getFirst(normalType) != null)
                    return true;

                var multiType = Il2CppType.Of<ActorMultiplayerLevelLogic>();
                if (GameScene.instance.logicManager.getFirst(multiType) != null)
                    return true;
            }
            catch
            {
            }

            return false;
        }

        private static AudioSource FindMusicSource()
        {
            if (_musicSource != null && _musicSource.isPlaying && _musicSource.clip != null)
            {
                return _musicSource;
            }

            _musicSource = null!;
            var sources = UnityEngine.Object.FindObjectsOfType<AudioSource>();
            if (sources == null) return null!;

            float longestClip = 0f;
            AudioSource candidate = null!;

            for (int i = 0; i < sources.Length; i++)
            {
                var src = sources[i];
                if (src != null && src.isPlaying)
                {
                    if (src.gameObject.name.Contains("JukeBox") || src.gameObject.name.Contains("Jukebox"))
                    {
                        _musicSource = src;
                        return _musicSource;
                    }

                    if (src.clip != null && src.clip.length > longestClip)
                    {
                        longestClip = src.clip.length;
                        candidate = src;
                    }
                }
            }

            _musicSource = candidate;
            return _musicSource;
        }

        private static void CopySpectrum(Il2CppStructArray<float> from, Il2CppStructArray<float> to)
        {
            for (int i = 0; i < from.Length; i++)
            {
                to[i] = from[i];
            }
        }

        // Линейный анализ частот с динамической автоподстройкой усиления (AGC)
        private static void AnalyzeAudio()
        {
            bool gotData = false;
            bool isStereo = false;

            for (int i = 0; i < 512; i++)
            {
                _rawSpectrumL[i] = 0f;
                _rawSpectrumR[i] = 0f;
            }

            // 1. Попытка чтения из конкретного AudioSource
            AudioSource src = FindMusicSource();
            if (src != null && src.isPlaying)
            {
                try
                {
                    isStereo = (src.clip != null && src.clip.channels > 1);

                    src.GetSpectrumData(_rawSpectrumL, 0, FFTWindow.Blackman);
                    if (isStereo)
                    {
                        try { src.GetSpectrumData(_rawSpectrumR, 1, FFTWindow.Blackman); }
                        catch { CopySpectrum(_rawSpectrumL, _rawSpectrumR); }
                    }
                    else
                    {
                        CopySpectrum(_rawSpectrumL, _rawSpectrumR);
                    }

                    if (_rawSpectrumL[0] > 0f || _rawSpectrumL[1] > 0f)
                    {
                        gotData = true;
                    }
                }
                catch
                {
                    gotData = false;
                }
            }

            // 2. Фоллбэк к AudioListener
            if (!gotData)
            {
                try
                {
                    AudioListener.GetSpectrumData(_rawSpectrumL, 0, FFTWindow.Blackman);
                    try
                    {
                        AudioListener.GetSpectrumData(_rawSpectrumR, 1, FFTWindow.Blackman);
                    }
                    catch
                    {
                        CopySpectrum(_rawSpectrumL, _rawSpectrumR);
                    }

                    if (_rawSpectrumL[0] > 0f || _rawSpectrumL[1] > 0f)
                    {
                        gotData = true;
                    }
                }
                catch
                {
                }
            }

            // 3. Фоллбэк к сканированию всех AudioSource
            if (!gotData)
            {
                try
                {
                    var allSources = UnityEngine.Object.FindObjectsOfType<AudioSource>();
                    if (allSources != null)
                    {
                        for (int i = 0; i < allSources.Length; i++)
                        {
                            var s = allSources[i];
                            if (s != null && s.isPlaying)
                            {
                                bool sourceStereo = (s.clip != null && s.clip.channels > 1);
                                s.GetSpectrumData(_rawSpectrumL, 0, FFTWindow.Blackman);
                                if (sourceStereo)
                                {
                                    try { s.GetSpectrumData(_rawSpectrumR, 1, FFTWindow.Blackman); }
                                    catch { CopySpectrum(_rawSpectrumL, _rawSpectrumR); }
                                }
                                else
                                {
                                    CopySpectrum(_rawSpectrumL, _rawSpectrumR);
                                }

                                if (_rawSpectrumL[0] > 0f || _rawSpectrumL[1] > 0f)
                                {
                                    _musicSource = s;
                                    gotData = true;
                                    break;
                                }
                            }
                        }
                    }
                }
                catch
                {
                }
            }

            // 4. Линейный расчет амплитуд
            int bandsPerChannel = TotalBands / 2; // 16 полос на канал
            float minFreq = 1f;
            float maxFreq = 511f;

            float[] rawAverages = new float[TotalBands];
            float currentFrameMax = 1e-10f;

            for (int i = 0; i < TotalBands; i++)
            {
                int bandIdx;
                Il2CppStructArray<float> activeSpectrum;

                if (i < bandsPerChannel)
                {
                    // Левая половина: басы справа (у центра), высокие уходят влево
                    bandIdx = (bandsPerChannel - 1) - i;
                    activeSpectrum = _rawSpectrumL;
                }
                else
                {
                    // Правая половина: басы слева (у центра), высокие уходят вправо
                    bandIdx = i - bandsPerChannel;
                    activeSpectrum = _rawSpectrumR;
                }

                float lowBound = minFreq * Mathf.Pow(maxFreq / minFreq, (float)bandIdx / bandsPerChannel);
                float highBound = minFreq * Mathf.Pow(maxFreq / minFreq, (float)(bandIdx + 1) / bandsPerChannel);

                int startBin = Mathf.FloorToInt(lowBound);
                int endBin = Mathf.CeilToInt(highBound);

                if (endBin <= startBin) endBin = startBin + 1;
                if (endBin > 511) endBin = 511;
                if (startBin > 511) startBin = 511;

                float sum = 0f;
                int count = 0;
                for (int j = startBin; j < endBin; j++)
                {
                    sum += activeSpectrum[j];
                    count++;
                }

                float average = sum / count;

                float eqMultiplier = 1f + Mathf.Pow((float)bandIdx / bandsPerChannel, EqPower) * EqScale;
                float averageWeighted = average * eqMultiplier;

                rawAverages[i] = averageWeighted;

                if (averageWeighted > currentFrameMax)
                {
                    currentFrameMax = averageWeighted;
                }
            }

            // Динамическая адаптация пика громкости (AGC)
            // Позволяет сохранять высокую амплитуду прыжков как на громких, так и на тихих моментах
            float dt = Mathf.Min(Time.deltaTime, 0.1f);
            if (currentFrameMax > _maxPeak)
            {
                _maxPeak = Mathf.Lerp(_maxPeak, currentFrameMax, 25f * dt); // Быстрый взлет адаптации
            }
            else
            {
                _maxPeak = Mathf.Lerp(_maxPeak, currentFrameMax, AutoGainSpeed * dt); // Плавный спад
            }

            if (_maxPeak < 1e-6f) _maxPeak = 1e-6f;

            // Назначение высот в линейном пространстве с авто-калибровкой
            for (int i = 0; i < TotalBands; i++)
            {
                float normalized = rawAverages[i] / _maxPeak;

                float value = Mathf.Pow(normalized, GammaCurve);
                if (value < 0f) value = 0f;
                if (value > 1f) value = 1f;

                _bands[i] = value * CustomMaxHeight;
            }

            // 5. Лёгкое пространственное сглаживание с силой SpatialSmoothingAmount
            float centerWeight = 1.0f - 2f * SpatialSmoothingAmount;
            for (int i = 0; i < TotalBands; i++)
            {
                float sum = 0f;
                float totalWeight = 0f;

                int[] offsets = { -1, 0, 1 };
                float[] weights = { SpatialSmoothingAmount, centerWeight, SpatialSmoothingAmount };

                for (int w = 0; w < offsets.Length; w++)
                {
                    int neighborIdx = i + offsets[w];
                    if (neighborIdx >= 0 && neighborIdx < TotalBands)
                    {
                        sum += _bands[neighborIdx] * weights[w];
                        totalWeight += weights[w];
                    }
                }

                _spatialSmoothedBands[i] = sum / totalWeight;
            }

            for (int i = 0; i < TotalBands; i++)
            {
                _bands[i] = _spatialSmoothedBands[i];
            }
        }

        private static void UpdateVisualizer()
        {
            if (_canvasObject == null || _barsContainer == null) return;

            AnalyzeAudio();

            float dt = Mathf.Min(Time.deltaTime, 0.1f);

            // Преобразуем настраиваемый Hue (розовый) в формат цвета Unity RGBA
            Color customColor = Color.HSVToRGB(VisualizerHue, 0.9f, 1.0f);
            customColor.a = BarAlpha;

            // Обновляем линию по центру
            if (_centralLine != null)
            {
                var lineRect = _centralLine.GetComponent<RectTransform>();
                if (lineRect != null)
                {
                    lineRect.sizeDelta = new Vector2(0f, LineThickness);
                    lineRect.anchoredPosition = new Vector2(0f, VerticalOffset);
                }

                var lineImg = _centralLine.GetComponent<Image>();
                if (lineImg != null) lineImg.color = customColor;
            }

            for (int i = 0; i < TotalBands; i++)
            {
                float targetHeight = Mathf.Clamp(_bands[i], 0f, CustomMaxHeight);

                if (targetHeight > _smoothedBands[i])
                {
                    _smoothedBands[i] = targetHeight; // Instant attack
                }
                else
                {
                    _smoothedBands[i] = Mathf.Lerp(_smoothedBands[i], targetHeight, DecaySpeed * dt);
                }

                if (_uiBars != null && _uiBars[i] != null)
                {
                    var rect = _uiBars[i].GetComponent<RectTransform>();
                    if (rect != null)
                    {
                        rect.sizeDelta = new Vector2(CustomBarWidth, _smoothedBands[i]);

                        float spacing = TotalWidth / (TotalBands - 1);
                        float startX = -TotalWidth / 2f;
                        float x = startX + i * spacing;
                        rect.anchoredPosition = new Vector2(x, VerticalOffset);
                    }

                    var img = _uiBars[i].GetComponent<Image>();
                    if (img != null) img.color = customColor;
                }
            }

            float shakeX = 0f;
            float shakeY = 0f;

            if (CameraFlash.mainCamera != null)
            {
                if (CameraFlash.mainCamera.actorForTransform != null)
                {
                    shakeX = CameraFlash.mainCamera.actorForTransform.px;
                    shakeY = CameraFlash.mainCamera.actorForTransform.py;
                }
            }

            _canvasObject.transform.position = new Vector3(0f, 0f, 1.51f);
            _canvasObject.transform.localScale = Vector3.one;

            var containerRect = _barsContainer.GetComponent<RectTransform>();
            if (containerRect != null)
            {
                containerRect.anchoredPosition = new Vector2(shakeX, -shakeY);
            }
        }

        public static void CreateVisuals()
        {
            if (_canvasObject != null) return;

            _canvasObject = new GameObject("AudioVisualizerCanvas");
            _canvasObject.layer = 0;
            UnityEngine.Object.DontDestroyOnLoad(_canvasObject);

            Canvas canvas = _canvasObject.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.WorldSpace;
            canvas.sortingOrder = -11;

            _canvasObject.transform.position = new Vector3(0f, 0f, 1.51f);
            _canvasObject.transform.localScale = Vector3.one;

            var rect = _canvasObject.GetComponent<RectTransform>();
            rect.sizeDelta = new Vector2(1280f, 720f);

            _barsContainer = new GameObject("BarsContainer");
            _barsContainer.layer = 0;
            _barsContainer.transform.SetParent(_canvasObject.transform, false);

            var containerRect = _barsContainer.AddComponent<RectTransform>();
            containerRect.anchorMin = Vector2.zero;
            containerRect.anchorMax = Vector2.one;
            containerRect.pivot = new Vector2(0.5f, 0.5f);
            containerRect.sizeDelta = Vector2.zero;
            containerRect.anchoredPosition = Vector2.zero;

            Color customColor = Color.HSVToRGB(VisualizerHue, 0.9f, 1.0f);
            customColor.a = BarAlpha;

            _centralLine = new GameObject("CentralLine");
            _centralLine.layer = 0;
            _centralLine.transform.SetParent(_barsContainer.transform, false);

            var lineRect = _centralLine.AddComponent<RectTransform>();
            lineRect.anchorMin = new Vector2(0f, 0.5f);
            lineRect.anchorMax = new Vector2(1f, 0.5f);
            lineRect.pivot = new Vector2(0.5f, 0.5f);
            lineRect.anchoredPosition = new Vector2(0f, VerticalOffset);
            lineRect.sizeDelta = new Vector2(0f, LineThickness);

            var lineImage = _centralLine.AddComponent<Image>();
            lineImage.color = customColor;

            _uiBars = new GameObject[TotalBands];

            float spacing = TotalWidth / (TotalBands - 1);
            float startX = -TotalWidth / 2f;

            for (int i = 0; i < TotalBands; i++)
            {
                GameObject bar = new GameObject($"VisualizerBar_{i}");
                bar.layer = 0;
                bar.transform.SetParent(_barsContainer.transform, false);

                var barRect = bar.AddComponent<RectTransform>();
                barRect.anchorMin = new Vector2(0.5f, 0.5f);
                barRect.anchorMax = new Vector2(0.5f, 0.5f);
                barRect.pivot = new Vector2(0.5f, 0.5f);

                float x = startX + i * spacing;
                barRect.anchoredPosition = new Vector2(x, VerticalOffset);
                barRect.sizeDelta = new Vector2(CustomBarWidth, 0f);

                var image = bar.AddComponent<Image>();
                image.color = customColor;

                _uiBars[i] = bar;
            }

            DebugStrings.Log("AudioVisualizer: created WorldSpace canvas, central line and 32 bars");
        }

        public static void DestroyVisuals()
        {
            if (_canvasObject != null)
            {
                UnityEngine.Object.Destroy(_canvasObject);
                _canvasObject = null!;
                _barsContainer = null!;
                _centralLine = null!;
                _uiBars = null!;
                _musicSource = null!;
                _maxPeak = 0.001f; // Сбрасываем пик громкости
            }
        }

        [HarmonyPatch(typeof(KeyManager), "update")]
        private static class Patch_KeyManager_Update_AudioVisualizer
        {
            private static int _menuLogCounter = 0;

            static void Postfix()
            {
                if (!Enabled)
                {
                    DestroyVisuals();
                    return;
                }

                if (IsPlayerOnLevel())
                {
                    _menuLogCounter = 0;
                    CreateVisuals();
                    UpdateVisualizer();
                }
                else
                {
                    DestroyVisuals();

                    _menuLogCounter++;
                    if (_menuLogCounter >= 180)
                    {
                        _menuLogCounter = 0;
                        DebugStrings.Log("AudioVisualizer enabled, but player is not on a level");
                    }
                }
            }
        }
    }
}
