using System;
using System.Collections.Generic;
using HarmonyLib;
using Il2Cpp;
using MelonLoader;
using UnityEngine;

namespace jsb_new
{
    public static class HitboxRenderer
    {
        // ==================== НАСТРОЙКИ ====================
        private static bool _enabled = false;

        public static bool Enabled
        {
            get => _enabled;
            set
            {
                if (_enabled == value) return;
                _enabled = value;
                VersionInfo.DEBUG_FORCE_ALL_COLLISIONS_VISIBLE = _enabled;
                DebugStrings.Log($"Hitboxes: {(_enabled ? "ON" : "OFF")}");

                if (!_enabled)
                    Cleanup();
            }
        }
        private static readonly Color DrawColor = Color.yellow;

        // ==================== ПРЕДВЫЧИСЛЕННЫЕ ТОЧКИ ====================
        private static readonly Vector2[] CirclePoints;
        private const int CircleSegments = 18;

        // ==================== КЭШ ====================
        private static CameraFlash? _cachedFlash;
        private static MainGame? _cachedMainGame;

        // ==================== РЕНДЕР-РЕСУРСЫ ====================
        private static Mesh? _lineMesh;
        private static Material? _lineMaterial;
        private static readonly List<Line> _lines = new(25000);
        private static Vector3[] _vertexBuffer = new Vector3[16384];
        private static Color32[] _colorBuffer = new Color32[16384];
        private static int[] _indexBuffer = Array.Empty<int>();
        private static bool _resourcesReady = false;

        static HitboxRenderer()
        {
            CirclePoints = new Vector2[CircleSegments];
            for (int i = 0; i < CircleSegments; i++)
            {
                float angle = i * 360f / CircleSegments * Mathf.Deg2Rad;
                CirclePoints[i] = new Vector2(Mathf.Cos(angle), Mathf.Sin(angle));
            }
        }

        // ==================== ИНИЦИАЛИЗАЦИЯ ====================
        public static void Initialize(HarmonyLib.Harmony harmony)
        {
            try
            {
                TrainerSettingsBuilder.Initialize(harmony);

                // Патчим круглые хитбоксы через attackTargets (для максимальной точности и отсутствия дублирования)
                var attackTargetsMethod = typeof(CollisionCircleComponent).GetMethod("attackTargets");
                if (attackTargetsMethod != null)
                    harmony.Patch(attackTargetsMethod, new HarmonyMethod(typeof(HitboxRenderer), nameof(OnAttackTargets)));

                // Патчим прямоугольные хитбоксы (Overload 1 через drawRectangle)
                var rectMethod = typeof(CollisionRectangleComponent).GetMethod("drawRectangle");
                if (rectMethod != null)
                    harmony.Patch(rectMethod, new HarmonyMethod(typeof(HitboxRenderer), nameof(OnDrawRectangle)));

                // Патчим прямоугольные хитбоксы (Overload 2 через DEBUG_draw в RectangleLines)
                var debugDrawMethod = typeof(RectangleLines).GetMethod("DEBUG_draw");
                if (debugDrawMethod != null)
                    harmony.Patch(debugDrawMethod, new HarmonyMethod(typeof(HitboxRenderer), nameof(OnDEBUG_draw)));

                var manageColMethod = AccessTools.Method(typeof(DisplayObjectRendererTk2d), "ManageCol");
                if (manageColMethod != null)
                    harmony.Patch(manageColMethod, new HarmonyMethod(typeof(HitboxRenderer), nameof(OnManageCol)));

                TrainerSettingsBuilder.AddCheckbox("Hitboxes", () => Enabled, (newValue) =>
                {
                    Enabled = newValue;
                });

                DebugStrings.Log("HitboxRenderer initialized (full version with Beams trajectory prediction)");
            }
            catch (Exception ex)
            {
                MelonLogger.Error($"[HitboxRenderer] Init failed: {ex.Message}");
            }
        }

        public static void Cleanup()
        {
            if (_lineMesh != null) { UnityEngine.Object.DestroyImmediate(_lineMesh); _lineMesh = null; }
            if (_lineMaterial != null) { UnityEngine.Object.DestroyImmediate(_lineMaterial); _lineMaterial = null; }

            _lines.Clear();
            _vertexBuffer = new Vector3[16384];
            _colorBuffer = new Color32[16384];
            _indexBuffer = Array.Empty<int>();
            _resourcesReady = false;
            _cachedFlash = null;
            _cachedMainGame = null;
        }

        // ==================== UPDATE ====================
        public static void Update()
        {
            if (Input.GetKeyDown(KeyCode.H))
            {
                Enabled = !Enabled;
            }

            if (!Enabled)
            {
                if (_lines.Count > 0) _lines.Clear();
                return;
            }

            UpdateCachedReferences();
            DrawPlayerHitboxes();
            DrawBeams(); // Отрисовка траектории лазеров наперед
            RenderLines();
        }

        private static void UpdateCachedReferences()
        {
            if (_cachedMainGame == null)
                _cachedMainGame = MainGame.instance;

            if (_cachedFlash == null)
                _cachedFlash = CameraFlash.mainCamera;
        }

        // ==================== BEAMS TRAJECTORY PREDICTION ====================
        private static void DrawBeams()
        {
            if (_cachedMainGame == null) return;
            var scene = _cachedMainGame.gameSceneManager?.gameScene;
            if (scene == null) return;

            var enemyList = scene.enemyManager?.actorList;
            if (enemyList == null) return;

            for (int i = 0; i < enemyList.Count; i++)
            {
                var actor = enemyList[i];
                if (actor == null || actor.destroyed) continue;

                // Рисуем будущую траекторию лазера только в состоянии предупреждения (!isInIdleTime),
                // чтобы избежать наложения линий во время фазы активного урона
                var beam = actor.TryCast<Beam>();
                if (beam != null)
                {
                    if (beam.timeline != null && !beam.timeline.isInIdleTime())
                    {
                        DrawBeamHitbox(beam);
                    }
                    continue;
                }

                var beamBorderless = actor.TryCast<BeamBorderless>();
                if (beamBorderless != null)
                {
                    if (beamBorderless.timeline != null && !beamBorderless.timeline.isInIdleTime())
                    {
                        DrawBeamBorderlessHitbox(beamBorderless);
                    }
                    continue;
                }
            }
        }

        private static void DrawBeamHitbox(Beam b)
        {
            if (_cachedFlash == null) return;
            try
            {
                bool mustOffset = false;
                try
                {
                    mustOffset = (bool)AccessTools.Field(typeof(Beam), "mustOffsetCol").GetValue(b);
                }
                catch { }

                float startX = b.px;
                float startY = b.py;
                if (mustOffset)
                {
                    startX += b.radius * MyMath.myCos(b.angle);
                    startY += b.radius * MyMath.mySin(b.angle);
                }

                float vx = MyMath.myCos(b.angle) * 2000f; // Стандартная длина луча из кода игры
                float vy = MyMath.mySin(b.angle) * 2000f;

                float localY = startY * -1f;
                float localVY = vy * -1f;

                Point p1 = _cachedFlash.getCoordInWorld(startX + 640f, localY + 360f);
                Point p2 = _cachedFlash.getCoordInWorld(startX + vx + 640f, localY + localVY + 360f);

                float offset = 0f;
                if (_cachedFlash.actorForTransform != null)
                    offset = (_cachedFlash.px - _cachedFlash.actorForTransform.px) * 2f;

                Vector3 pA = new Vector3(p1.x - offset, p1.y, 0f);
                Vector3 pB = new Vector3(p2.x - offset, p2.y, 0f);

                // Отрисовка траектории предупреждения желтым цветом
                AddCapsule(pA, pB, b.radius, DrawColor);
            }
            catch (Exception ex)
            {
                MelonLogger.Error($"[Hitbox] DrawBeamHitbox error: {ex.Message}");
            }
        }

        private static void DrawBeamBorderlessHitbox(BeamBorderless b)
        {
            if (_cachedFlash == null) return;
            try
            {
                bool mustOffset = false;
                try
                {
                    mustOffset = (bool)AccessTools.Field(typeof(BeamBorderless), "mustOffsetCol").GetValue(b);
                }
                catch { }

                float startX = b.px;
                float startY = b.py;
                if (mustOffset)
                {
                    startX += b.radius * MyMath.myCos(b.angle);
                    startY += b.radius * MyMath.mySin(b.angle);
                }

                float len = b.height - b.radius * 2f; // Длина безграничного луча из кода игры
                float vx = MyMath.myCos(b.angle) * len;
                float vy = MyMath.mySin(b.angle) * len;

                float localY = startY * -1f;
                float localVY = vy * -1f;

                Point p1 = _cachedFlash.getCoordInWorld(startX + 640f, localY + 360f);
                Point p2 = _cachedFlash.getCoordInWorld(startX + vx + 640f, localY + localVY + 360f);

                float offset = 0f;
                if (_cachedFlash.actorForTransform != null)
                    offset = (_cachedFlash.px - _cachedFlash.actorForTransform.px) * 2f;

                Vector3 pA = new Vector3(p1.x - offset, p1.y, 0f);
                Vector3 pB = new Vector3(p2.x - offset, p2.y, 0f);

                // Отрисовка траектории предупреждения желтым цветом
                AddCapsule(pA, pB, b.radius, DrawColor);
            }
            catch (Exception ex)
            {
                MelonLogger.Error($"[Hitbox] DrawBeamBorderlessHitbox error: {ex.Message}");
            }
        }

        // ==================== PLAYER HITBOXES ====================
        private static void DrawPlayerHitboxes()
        {
            if (_cachedMainGame == null) return;
            var scene = _cachedMainGame.gameSceneManager?.gameScene;
            if (scene == null) return;

            var actorList = scene.heroManager?.actorList;
            if (actorList == null) return;

            for (int i = 0; i < actorList.Count; i++)
            {
                var actor = actorList[i];
                if (actor == null) continue;

                var hero = actor.TryCast<Hero>();
                if (hero == null) continue;

                var enemyComp = hero.circleColComponentEnemy;
                if (enemyComp?.circleCol != null && enemyComp.enabled)
                    DrawCircleComponent(enemyComp, enemyComp.circleCol);

                var itemComp = hero.circleColComponentItem;
                if (itemComp?.circleCol != null && itemComp.enabled)
                    DrawCircleComponent(itemComp, itemComp.circleCol);
            }
        }

        private static void DrawCircleComponent(CollisionCircleComponent comp, Circle c)
        {
            if (_cachedFlash == null || comp.actor == null) return;

            var actor = comp.actor;
            float flashX = actor.px + c.x;
            float flashY = (actor.py + c.y) * -1f;
            float offset = (_cachedFlash.px - (_cachedFlash.actorForTransform?.px ?? 0f)) * 2f;

            Point p = _cachedFlash.getCoordInWorld(flashX + 640f, flashY + 360f);
            AddCircle(p.x - offset, p.y, c.radius, DrawColor);
        }

        // ==================== РЕНДЕР ====================
        private static void RenderLines()
        {
            if (_lines.Count == 0) return;

            if (!_resourcesReady)
                InitResources();

            if (_lineMesh == null || _lineMaterial == null) return;

            int vertexCount = _lines.Count * 2;
            EnsureCapacity(vertexCount);

            for (int i = 0; i < _lines.Count; i++)
            {
                var line = _lines[i];
                int idx = i * 2;
                _vertexBuffer[idx] = line.A;
                _vertexBuffer[idx + 1] = line.B;
                _colorBuffer[idx] = line.Color;
                _colorBuffer[idx + 1] = line.Color;
            }

            _lineMesh.Clear(keepVertexLayout: true);
            _lineMesh.SetVertices(_vertexBuffer, 0, vertexCount);
            _lineMesh.SetColors(_colorBuffer, 0, vertexCount);
            _lineMesh.SetIndices(_indexBuffer, 0, vertexCount, MeshTopology.Lines, 0, false);

            var cam = Camera.main ?? UnityEngine.Object.FindObjectOfType<Camera>();
            if (cam != null)
                Graphics.DrawMesh(_lineMesh, Vector3.zero, Quaternion.identity, _lineMaterial, 0, cam);

            _lines.Clear();
        }

        private static void InitResources()
        {
            try
            {
                _lineMesh = new Mesh
                {
                    hideFlags = HideFlags.HideAndDontSave,
                    bounds = new Bounds(Vector3.zero, new Vector3(100000f, 100000f, 100000f))
                };
                _lineMesh.MarkDynamic();

                _indexBuffer = new int[50000];
                for (int i = 0; i < _indexBuffer.Length; i++) _indexBuffer[i] = i;

                var shader = Shader.Find("Hidden/Internal-Colored") ?? Shader.Find("Sprites/Default");
                if (shader == null) throw new Exception("Shader not found");

                _lineMaterial = new Material(shader)
                {
                    hideFlags = HideFlags.HideAndDontSave
                };
                _lineMaterial.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                _lineMaterial.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                _lineMaterial.SetInt("_Cull", (int)UnityEngine.Rendering.CullMode.Off);
                _lineMaterial.SetInt("_ZWrite", 0);
                _lineMaterial.SetInt("_ZTest", 8);
                _lineMaterial.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Overlay;

                _resourcesReady = true;
            }
            catch (Exception ex)
            {
                MelonLogger.Error($"[HitboxRenderer] Init resources failed: {ex.Message}");
                _resourcesReady = false;
            }
        }

        private static void EnsureCapacity(int size)
        {
            if (_vertexBuffer.Length >= size) return;
            int newSize = Mathf.NextPowerOfTwo(Mathf.Max(size, 16384));
            Array.Resize(ref _vertexBuffer, newSize);
            Array.Resize(ref _colorBuffer, newSize);
        }

        // ==================== ДОБАВЛЕНИЕ ЛИНИЙ ====================
        private static void AddLine(Vector3 a, Vector3 b)
        {
            AddLine(a, b, DrawColor);
        }

        private static void AddLine(Vector3 a, Vector3 b, Color color)
        {
            if (_lines.Count >= 25000) return;
            _lines.Add(new Line { A = a, B = b, Color = color });
        }

        private static void AddCircle(float cx, float cy, float radius)
        {
            AddCircle(cx, cy, radius, DrawColor);
        }

        private static void AddCircle(float cx, float cy, float radius, Color color)
        {
            if (radius <= 0f) return;

            Vector3 prev = new Vector3(cx + CirclePoints[0].x * radius, cy + CirclePoints[0].y * radius, 0f);
            for (int i = 1; i <= CircleSegments; i++)
            {
                int idx = i % CircleSegments;
                Vector3 next = new Vector3(cx + CirclePoints[idx].x * radius, cy + CirclePoints[idx].y * radius, 0f);
                AddLine(prev, next, color);
                prev = next;
            }
        }

        private static void AddCapsule(Vector3 a, Vector3 b, float radius)
        {
            AddCapsule(a, b, radius, DrawColor);
        }

        private static void AddCapsule(Vector3 a, Vector3 b, float radius, Color color)
        {
            if (radius <= 0f) return;
            AddCircle(a.x, a.y, radius, color);
            AddCircle(b.x, b.y, radius, color);

            Vector3 dir = b - a;
            float len = dir.magnitude;
            if (len < 0.001f) return;
            dir /= len;
            Vector3 perp = new Vector3(-dir.y * radius, dir.x * radius, 0f);

            AddLine(a + perp, b + perp, color);
            AddLine(a - perp, b - perp, color);
        }

        // ==================== ПАТЧИ ====================
        public static bool OnAttackTargets(float x, float y, float radius, float vx, float vy)
        {
            if (!_enabled) return true;
            try
            {
                if (_cachedFlash == null) return true;
                float localY = y * -1f;
                float localVY = vy * -1f;
                float offset = 0f;
                if (_cachedFlash.actorForTransform != null)
                    offset = (_cachedFlash.px - _cachedFlash.actorForTransform.px) * 2f;

                if (vx == 0f && vy == 0f)
                {
                    Point p = _cachedFlash.getCoordInWorld(x + 640f, localY + 360f);
                    AddCircle(p.x - offset, p.y, radius, Color.red); // Красный цвет для активного урона
                }
                else
                {
                    Point p1 = _cachedFlash.getCoordInWorld(x + 640f, localY + 360f);
                    Point p2 = _cachedFlash.getCoordInWorld(x + vx + 640f, localY + localVY + 360f);

                    Vector3 a = new Vector3(p1.x - offset, p1.y, 0f);
                    Vector3 b = new Vector3(p2.x - offset, p2.y, 0f);
                    AddCapsule(a, b, radius, Color.red); // Красный цвет для активного урона
                }
            }
            catch (Exception ex) { MelonLogger.Error($"[Hitbox] OnAttackTargets error: {ex.Message}"); }
            return true;
        }

        public static bool OnDrawRectangle(float x, float y, float scaleX, float scaleY, float rot)
        {
            if (!_enabled) return false;
            try
            {
                if (_cachedFlash == null) return false;
                float localY = y * -1f;
                Point p = _cachedFlash.getCoordInWorld(x + 640f, localY + 360f);
                float offset = 0f;
                if (_cachedFlash.actorForTransform != null)
                    offset = (_cachedFlash.px - _cachedFlash.actorForTransform.px) * 2f;

                float wx = p.x - offset;
                float wy = p.y;
                float halfW = 25f * scaleX;
                float halfH = 25f * scaleY;

                Vector2[] corners = new Vector2[4];
                corners[0] = RotatePoint(-halfW, -halfH, rot);
                corners[1] = RotatePoint(halfW, -halfH, rot);
                corners[2] = RotatePoint(halfW, halfH, rot);
                corners[3] = RotatePoint(-halfW, halfH, rot);

                for (int i = 0; i < 4; i++)
                {
                    corners[i].x += wx;
                    corners[i].y += wy;
                }

                // Красный цвет для активного урона прямоугольников
                AddLine(new Vector3(corners[0].x, corners[0].y, 0f), new Vector3(corners[1].x, corners[1].y, 0f), Color.red);
                AddLine(new Vector3(corners[1].x, corners[1].y, 0f), new Vector3(corners[2].x, corners[2].y, 0f), Color.red);
                AddLine(new Vector3(corners[2].x, corners[2].y, 0f), new Vector3(corners[3].x, corners[3].y, 0f), Color.red);
                AddLine(new Vector3(corners[3].x, corners[3].y, 0f), new Vector3(corners[0].x, corners[0].y, 0f), Color.red);
            }
            catch (Exception ex) { MelonLogger.Error($"[Hitbox] OnDrawRectangle error: {ex.Message}"); }
            return false;
        }

        public static bool OnDEBUG_draw(RectangleLines __instance)
        {
            if (!_enabled || __instance == null) return true;
            try
            {
                // Считываем уже вычисленные и преобразованные координаты из экземпляра __instance и рисуем красным
                AddLine(new Vector3(__instance.l1.x1, __instance.l1.y1, 0f), new Vector3(__instance.l1.x2, __instance.l1.y2, 0f), Color.red);
                AddLine(new Vector3(__instance.l2.x1, __instance.l2.y1, 0f), new Vector3(__instance.l2.x2, __instance.l2.y2, 0f), Color.red);
                AddLine(new Vector3(__instance.l3.x1, __instance.l3.y1, 0f), new Vector3(__instance.l3.x2, __instance.l3.y2, 0f), Color.red);
                AddLine(new Vector3(__instance.l4.x1, __instance.l4.y1, 0f), new Vector3(__instance.l4.x2, __instance.l4.y2, 0f), Color.red);
            }
            catch (Exception ex) { MelonLogger.Error($"[Hitbox] OnDEBUG_draw error: {ex.Message}"); }
            return false; // Возвращаем false, чтобы заблокировать стандартную отрисовку Debug.DrawLine в игре
        }

        public static bool OnManageCol(DisplayObjectRendererTk2d __instance, DisplayObject d)
        {
            // Обрабатываем исключительно прямоугольные коллайдеры (colType == 2).
            // Круглые коллайдеры (colType == 1) мы здесь целенаправленно пропускаем,
            // поскольку они теперь полноценно отрисовываются через OnAttackTargets.
            if (!_enabled || __instance == null || d == null || d.colType != 2) return true;
            try
            {
                var rectLines = __instance.rectLines;
                if (rectLines == null) return true;

                rectLines.calculate(d.transform.concatenedMatrix);

                AddLine(new Vector3(rectLines.l1.x1, rectLines.l1.y1, 0f), new Vector3(rectLines.l1.x2, rectLines.l1.y2, 0f));
                AddLine(new Vector3(rectLines.l2.x1, rectLines.l2.y1, 0f), new Vector3(rectLines.l2.x2, rectLines.l2.y2, 0f));
                AddLine(new Vector3(rectLines.l3.x1, rectLines.l3.y1, 0f), new Vector3(rectLines.l3.x2, rectLines.l3.y2, 0f));
                AddLine(new Vector3(rectLines.l4.x1, rectLines.l4.y1, 0f), new Vector3(rectLines.l4.x2, rectLines.l4.y2, 0f));
            }
            catch (Exception ex) { MelonLogger.Error($"[Hitbox] OnManageCol error: {ex.Message}"); }
            return true;
        }

        private static Vector2 RotatePoint(float x, float y, float rot)
        {
            float rad = rot * Mathf.Deg2Rad;
            float cos = Mathf.Cos(rad);
            float sin = Mathf.Sin(rad);
            return new Vector2(cos * x - sin * y, sin * x + cos * y);
        }

        private struct Line
        {
            public Vector3 A;
            public Vector3 B;
            public Color32 Color;
        }
    }
}
